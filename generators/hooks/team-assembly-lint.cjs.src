#!/usr/bin/env node
// BMAD Swarm - PreToolUse declared-intent lint on Agent team spawns
// Generated by bmad-swarm - do not edit manually
//
// CLASSIFICATION (ADR-015, D-039): this is an ADVISORY declared-intent
// lint, not an authorization boundary. The orchestrator writes the log
// file this hook reads, so the check can never bind a misbehaving actor;
// what it catches is the honest-mistake class — spawning a team without
// first declaring a plan. It declines the spawn with a corrective
// message; it does not claim to enforce anything.
//
// Anchor (ADR-015, supersedes ADR-013's matcher on the removed
// team-creation tool): teams now form implicitly on the first
// Agent-tool spawn, so the lint fires on
// PreToolUse:Agent. It no-ops unless the call is an orchestrator
// main-thread spawn of a bmad team role:
//   - subagent spawns (event.agent_id / agent_type present) pass through,
//   - calls without tool_input.subagent_type pass through,
//   - subagent_type values with no .claude/agents/<type>.md definition
//     (built-in types like Explore or general-purpose) pass through.
//
// Pass 1 (handshake mechanics carried forward from ADR-013): the
// orchestrator appends a fenced bmad-assembly block to
// artifacts/context/team-assembly-log.md immediately before every team
// spawn. The lint reads that log (cwd-relative), anchors on the LAST
// fenced bmad-assembly block in the whole file (append-only log; no byte
// window — F-009 fix), and requires all 5 keys plus a fresh file mtime
// (< 15 minutes old, and not in the future beyond clock-skew tolerance —
// F-022 fix). The transcript is never read: transcript shapes are harness
// internals and drifted twice (GATE-1, HARN-2); the repo-controlled
// handshake file is the only stable channel. Missing/stale/incomplete
// declaration = decline with an actionable message. Fail-open is reserved
// for environmental errors (unparseable stdin, unreadable swarm.yaml,
// missing js-yaml).
//
// Pass 2 (ADR-008, D-009): fixed-mode routing check. After Pass 1
// accepts the bmad-assembly envelope shape, Pass 2 reads swarm.yaml from
// CWD. When team.mode === 'fixed', it validates each team[].entry against
// team.specializations: specialized roles (developer, reviewer) with a
// matching (role, domain) pair pass; without a domain, fall back to
// team.fallback (when enabled and role matches); unspecialized roles pass
// unconditionally. Fail-open posture: missing/malformed swarm.yaml or any
// js-yaml require/parse failure skips Pass 2 silently (D-012). Routing
// failures are correctness issues, not security issues — the reviewer is
// the backstop. Dynamic mode (or absent team block) sees zero behavior
// change.

const fs = require('fs');
const path = require('path');
let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => {
  let event;
  try { event = JSON.parse(input); } catch { process.exit(0); }

  // Subagent context: teammates spawning their own helpers are not team
  // assembly. Same discriminator as orchestrator-write-gate (ADR-003).
  if (event.agent_id || event.agent_type) { process.exit(0); }

  const spawnInput = event.tool_input || {};
  const subagentType = spawnInput.subagent_type;
  if (!subagentType || typeof subagentType !== 'string') { process.exit(0); }

  // Team-spawn discriminator: only spawns of bmad-generated role
  // definitions (.claude/agents/<type>.md) are team assembly.
  const roleDefPath = path.join(process.cwd(), '.claude', 'agents', subagentType + '.md');
  if (!fs.existsSync(roleDefPath)) { process.exit(0); }

  const REQUIRED_KEYS = ['entry_point', 'complexity', 'autonomy', 'team', 'rationale'];
  const LOG_REL = 'artifacts/context/team-assembly-log.md';
  const FRESH_MS = 15 * 60 * 1000;
  // Clock-skew tolerance for the future-mtime bound (F-022). Small enough
  // that a wrongly future-dated log cannot stay "fresh" forever, large
  // enough to absorb filesystem/NFS timestamp skew.
  const SKEW_MS = 2 * 60 * 1000;
  const APPEND_HOWTO = 'append a fenced bmad-assembly block (keys: ' + REQUIRED_KEYS.join(', ') + ') to ' + LOG_REL + ', then retry the Agent spawn. (Advisory declared-intent lint, ADR-015 — it checks that a team plan was declared; it is not an authorization boundary.)';
  const FENCE_RE = /```bmad-assembly\s*\n([\s\S]*?)\n```/g;

  function deny(reason) {
    process.stdout.write(JSON.stringify({
      hookSpecificOutput: {
        hookEventName: 'PreToolUse',
        permissionDecision: 'deny',
        permissionDecisionReason: reason,
      },
    }));
    process.exit(0);
  }
  function denyRouting(reason) {
    deny(reason);
  }
  function missingKeys(block) {
    return REQUIRED_KEYS.filter(k => !new RegExp('^\\s*' + k + ':', 'm').test(block));
  }

  // Pass 1 (handshake mechanics from ADR-013): the log file is the sole channel.
  const logPath = path.join(process.cwd(), LOG_REL);
  let st;
  try { st = fs.statSync(logPath); } catch {
    deny('Assembly lint: no team-assembly declaration found (' + LOG_REL + ' does not exist) — ' + APPEND_HOWTO);
  }
  // F-022: bound freshness in BOTH directions. A stale log means no plan
  // was declared for this spawn; a future mtime (beyond skew tolerance)
  // means a broken or forged timestamp that would otherwise stay "fresh"
  // forever.
  const ageMs = Date.now() - st.mtimeMs;
  if (ageMs >= FRESH_MS) {
    deny('Assembly lint: the team-assembly declaration is stale (' + LOG_REL + ' was last modified 15+ minutes ago) — ' + APPEND_HOWTO);
  }
  if (ageMs < -SKEW_MS) {
    deny('Assembly lint: ' + LOG_REL + ' has a modification time in the future (beyond clock-skew tolerance) — fix the file timestamp, then ' + APPEND_HOWTO);
  }
  let logRaw;
  try { logRaw = fs.readFileSync(logPath, 'utf8'); } catch {
    deny('Assembly lint: could not read the team-assembly declaration (' + LOG_REL + ') — ' + APPEND_HOWTO);
  }
  // The log is append-only, so the LAST fenced block in the file is the one
  // the orchestrator just wrote for this team spawn.
  let m;
  let lastBlock = null;
  let lastEnd = 0;
  while ((m = FENCE_RE.exec(logRaw)) !== null) { lastBlock = m[1]; lastEnd = m.index + m[0].length; }
  // F-011: an opener AFTER the last complete match means the newest append
  // never closed its fence — deny instead of silently accepting the
  // previous (stale) block on a fresh mtime.
  if (logRaw.indexOf('```bmad-assembly', lastEnd) !== -1) {
    deny('Assembly lint: the newest bmad-assembly block in ' + LOG_REL + ' is unclosed (missing its closing fence) — close the fence or ' + APPEND_HOWTO);
  }
  if (lastBlock === null) {
    deny('Assembly lint: no fenced bmad-assembly block found in ' + LOG_REL + ' — ' + APPEND_HOWTO);
  }
  const missing = missingKeys(lastBlock);
  if (missing.length > 0) {
    deny('Assembly lint: the last bmad-assembly block in ' + LOG_REL + ' is incomplete. Missing: ' + missing.join(', ') + ' — ' + APPEND_HOWTO);
  }
  const acceptedBlock = lastBlock;

  // Pass 2 (ADR-008): fixed-mode routing check. Fail-open on every
  // error path — missing swarm.yaml, missing js-yaml dep, parse error, or
  // unexpected shape. Pass 2 runs ONLY after Pass 1 has accepted.
  let yaml;
  try { yaml = require('js-yaml'); } catch { process.exit(0); }

  const swarmYamlPath = path.join(process.cwd(), 'swarm.yaml');
  if (!fs.existsSync(swarmYamlPath)) { process.exit(0); }
  let swarmRaw;
  try { swarmRaw = fs.readFileSync(swarmYamlPath, 'utf8'); } catch { process.exit(0); }
  let swarmConfig;
  try { swarmConfig = yaml.load(swarmRaw); } catch { process.exit(0); }
  if (!swarmConfig || typeof swarmConfig !== 'object') { process.exit(0); }

  const teamCfg = swarmConfig.team || {};
  const mode = teamCfg.mode || 'dynamic';
  if (mode !== 'fixed') { process.exit(0); }

  const specs = Array.isArray(teamCfg.specializations) ? teamCfg.specializations : [];
  const fallback = teamCfg.fallback || {};
  // Match utils/config.js defaults: enabled defaults to true, role defaults
  // to 'developer'. The hook duplicates this default-application logic
  // intentionally — it does not import from utils/config.js to keep the
  // hook a self-contained CommonJS script (D-012).
  const fallbackEnabled = fallback.enabled !== false;
  const fallbackRole = fallback.role || 'developer';

  const SPECIALIZED_ROLES = new Set(['developer', 'reviewer']);

  let assembly;
  try { assembly = yaml.load(acceptedBlock); } catch { process.exit(0); }
  if (!assembly || typeof assembly !== 'object') { process.exit(0); }
  const teamArray = Array.isArray(assembly.team) ? assembly.team : [];

  for (const entry of teamArray) {
    if (!entry || typeof entry !== 'object') continue;
    const role = entry.role;
    if (!role || !SPECIALIZED_ROLES.has(role)) continue;

    const domain = entry.domain;
    if (domain) {
      const matched = specs.some(s => s && s.role === role && s.domain === domain);
      if (!matched) {
        denyRouting('Team routing check: team mode is "fixed" but the team[] entry "' + role + ' domain=' + domain + '" does not match any declared specialist in swarm.yaml:team.specializations and fallback is disabled. Either declare the specialist or set team.fallback.enabled: true.');
        process.exit(0);
      }
    } else {
      if (!(fallbackEnabled && fallbackRole === role)) {
        denyRouting('Team routing check: team mode is "fixed" but the team[] entry "' + role + '" (no domain) does not match any declared specialist in swarm.yaml:team.specializations and fallback is disabled. Either declare the specialist or set team.fallback.enabled: true.');
        process.exit(0);
      }
    }
  }

  process.exit(0);
});
