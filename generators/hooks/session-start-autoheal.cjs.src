#!/usr/bin/env node
// BMAD Swarm - AUTO-HEAL DELIVERY (F-29/F-30). Generated by bmad-swarm - do not
// edit manually.
//
// THE PROBLEM: "10 installs, 10 vintages, 0 current". A project scaffolded by an
// OLD bmad-swarm keeps running its stale .claude/ scaffold forever; fixes shipped
// to the npm package never reach it because nothing re-generates the scaffold.
//
// THE FIX: at a FRESH session start, compare the installed package version to the
// version stamp the scaffold was generated with (.claude/.bmad-version.json). On
// drift, HEAL per swarm.yaml `delivery.auto_heal`:
//   off   -> do nothing (opt out).
//   offer -> inject a one-line update offer (DEFAULT). Regenerates NOTHING, so it
//            cannot hot-swap the running session's hooks (live-swap hazard, D-045).
//   auto  -> run `bmad-swarm update` at this fresh-start window, then report what
//            healed. Falls back to `offer` on any failure.
//
// LIVE-SWAP SAFETY (D-045): this hook is registered ONLY on the SessionStart
// `startup` matcher, never `compact`, so it never fires mid-session — regenerating
// hooks after compaction (deep inside a live session) is exactly the wedge D-045
// guards. As a belt-and-suspenders, `auto` degrades to `offer` unless the event
// source is `startup`. `bmad-swarm update` additionally honors its OWN
// `.session-active` live-swap guard; at a genuine fresh start that marker is absent
// (it is written on the first human prompt), so hooks regenerate in the safe window.
//
// Self-contained: node builtins only (this file ships standalone into the field
// project's .claude/hooks/). ALWAYS exit 0 — auto-heal is advisory, never blocking.

const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

const VALID_MODES = ['auto', 'offer', 'off'];
const DEFAULT_MODE = 'offer';
const STAMP_FILENAME = '.bmad-version.json';

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => { try { run(); } catch { /* never break startup */ } process.exit(0); });
process.stdin.on('error', () => { process.exit(0); });

function run() {
  let event = {};
  try { event = JSON.parse(input); } catch { /* payload optional */ }

  const projectRoot = process.env.CLAUDE_PROJECT_DIR || event.cwd || process.cwd();

  // Not a bmad-swarm project (or nothing to heal) -> silent no-op.
  const swarmYamlPath = path.join(projectRoot, 'swarm.yaml');
  if (!fs.existsSync(swarmYamlPath)) return;

  const mode = readAutoHealMode(swarmYamlPath);
  if (mode === 'off') return;

  const drift = detectDrift(projectRoot);
  if (!drift.drifted) return; // idempotent: no drift, zero noise.

  // `auto` only ACTS at a genuine fresh startup; anything else downgrades to a
  // non-mutating offer (never regenerate outside the safe window).
  const source = typeof event.source === 'string' ? event.source : 'startup';
  if (mode === 'auto' && source === 'startup') {
    const healed = runUpdate(projectRoot, drift);
    if (healed) { emit(healed); return; }
    // fall through to the offer message if update could not run.
  }

  emit(offerLine(drift));
}

// ---- config -----------------------------------------------------------------

// Self-contained YAML read: we only need one scalar. A top-level `delivery:`
// block with an `auto_heal:` key; `auto_heal` is a unique key name in the schema,
// so a global match is unambiguous without a YAML parser.
function readAutoHealMode(swarmYamlPath) {
  let text = '';
  try { text = fs.readFileSync(swarmYamlPath, 'utf8'); } catch { return DEFAULT_MODE; }
  const m = /^\s*auto_heal:\s*["']?(auto|offer|off)["']?\s*(?:#.*)?$/m.exec(text);
  return m && VALID_MODES.includes(m[1]) ? m[1] : DEFAULT_MODE;
}

// ---- drift detection --------------------------------------------------------

// AH-1 (security): the stamp is attacker-writable and drift.from/to are embedded
// VERBATIM into the model-facing SessionStart additionalContext below. A version
// that is not a clean, fully-anchored semver (e.g. "1.0.0\n\nIGNORE PRIOR…") is a
// prompt-injection payload — reject it as no-stamp so it never reaches context.
// Anchored end-to-end, NOT a prefix test, so a valid-looking prefix cannot smuggle
// a trailing injection through.
const STAMP_VERSION_RE = /^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)*$/;

function detectDrift(projectRoot) {
  const stampPath = path.join(projectRoot, '.claude', STAMP_FILENAME);
  let stamp = null;
  if (fs.existsSync(stampPath)) {
    try {
      const obj = JSON.parse(fs.readFileSync(stampPath, 'utf8'));
      if (obj && typeof obj === 'object' && typeof obj.version === 'string'
          && STAMP_VERSION_RE.test(obj.version)) stamp = obj;
    } catch { /* corrupt stamp -> treat as no-stamp */ }
  }

  if (!stamp) return { drifted: true, kind: 'no-stamp', from: null, to: null };

  const current = currentPackageVersion();
  if (current && stamp.version !== current) {
    return { drifted: true, kind: 'version', from: stamp.version, to: current };
  }
  // Cannot resolve the installed version -> do not false-alarm on a stamped
  // scaffold (fail-safe). Version bumps are the field-realistic drift signal.
  return { drifted: false, kind: 'none', from: stamp.version, to: current };
}

// The installed bmad-swarm version. A test seam (env) takes precedence; otherwise
// ask the globally-installed CLI. Best-effort: any failure -> undefined.
function currentPackageVersion() {
  const override = process.env.BMAD_AUTOHEAL_CURRENT_VERSION;
  if (override) return override.trim();
  try {
    const r = spawnSync('bmad-swarm', ['--version'], { encoding: 'utf8', timeout: 5000 });
    if (r.status === 0 && r.stdout) {
      const v = r.stdout.trim().split('\n').pop().trim();
      if (/^\d+\.\d+\.\d+/.test(v)) return v;
    }
  } catch { /* CLI not on PATH (npx/local install) -> cannot compare */ }
  return undefined;
}

// ---- heal -------------------------------------------------------------------

// Run `bmad-swarm update` at the fresh-start safe window. Returns a summary line
// on success, or null if update could not run (caller falls back to the offer).
function runUpdate(projectRoot, drift) {
  const cmd = process.env.BMAD_AUTOHEAL_UPDATE_CMD || 'bmad-swarm'; // test seam
  let r;
  try {
    r = spawnSync(cmd, ['update'], { cwd: projectRoot, encoding: 'utf8', timeout: 120000 });
  } catch {
    return null;
  }
  if (!r || r.status !== 0) return null;
  const to = drift.to || currentPackageVersion() || 'the installed version';
  const from = drift.from ? `${drift.from} -> ` : '';
  return `AUTO-HEAL: drift detected (${from}${to}); ran \`bmad-swarm update\` at this fresh session `
    + 'start to refresh the .claude/ scaffold. Hooks/settings regenerated only in the safe fresh-start '
    + 'window (update honors its .session-active live-swap guard).';
}

function offerLine(drift) {
  if (drift.kind === 'no-stamp') {
    return 'AUTO-HEAL: this .claude/ scaffold predates version stamping (generated by an older '
      + 'bmad-swarm). Run `bmad-swarm update` to refresh it — safe: update skips live hooks while a '
      + 'session is active.';
  }
  return `AUTO-HEAL: bmad-swarm ${drift.to} is installed but this .claude/ scaffold was generated by `
    + `${drift.from}. Run \`bmad-swarm update\` to refresh it — safe: update skips live hooks while a `
    + 'session is active.';
}

// ---- output -----------------------------------------------------------------

function emit(message) {
  if (!message) return;
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'SessionStart',
      additionalContext: message,
    },
  }));
}
