#!/usr/bin/env node
// BMAD Swarm - PreToolUse gate: the orchestrator role's write boundary.
// Generated by bmad-swarm - do not edit manually
//
// PRIMARY control lives in settings.json, NOT here: the orchestrator's Bash
// allow-list is deny-by-default and read-only (git status/log/diff/show, ls,
// grep, rg, cat, pwd, npm test) plus exactly two pinned scripts
// (node .claude/bmad/bin/record.cjs, node .claude/bmad/bin/replay-check.cjs).
// A general interpreter shell (node/python/perl/xargs/find -exec, …) is simply
// not grantable, so the subshell/wrapper/stdin-fed-interpreter bypasses that
// defeat any leading-binary token-scan (F-016) never reach a running command.
//
// This hook is the DEFENSE-IN-DEPTH TRIPWIRE for the file-writing tools and a
// second net over Bash write-shapes — deliberately NOT the sole control. It
// matches Edit|Write|MultiEdit|Bash|NotebookEdit and, for the orchestrator
// identity only:
//   - confines the file tools to the writable set;
//   - denies write-shaped shell (redirection, tee/dd/sed -i/cp/mv/install/
//     truncate/ln, WRITE-VECTOR + DESTRUCTIVE git, editors, and any interpreter
//     that is not one of the two pinned scripts), scanning quote-aware and
//     recursing into command substitutions.
//
// git (ADR-017 Amendment 1): coordination git is ALLOWED (commit, push, fetch,
// merge --ff-only, checkout/switch branch-form, branch, tag) — the settings.json
// allow-list stops PROMPTING for these, this gate denies the write/destructive
// vectors inside them: apply/restore/am/stash/mv/rm, checkout|switch with a
// pathspec, reset --hard/--merge/--keep, clean, push --force-family, non-ff
// merge, pull without --ff-only, rebase/filter-branch/update-ref, -c alias.*,
// --exec-path. Option-with-argument globals (-C, -c, --git-dir, --work-tree,
// --namespace) are consumed BEFORE the subcommand is resolved (the -C bug:
// `git -C /path apply x` must not read `/path` as the subcommand).
//
// Two-layer identity check (per ADR-003, HARN-1 fix) — UNCHANGED:
//   (1) event.agent_id / event.agent_type are populated only inside a subagent
//       (teammate) call; main-thread orchestrator calls have neither. Teammates
//       pass through here and keep their full working shell.
//   (2) AGENT_ROLE=orchestrator (settings.json env), defense in depth + the
//       in-session override path.
//
// Writable set (F-017 hardened: normalize + `..` reject + segment-anchored
// prefix + realpath of the nearest existing ancestor, so lexical tricks and a
// symlinked ancestor are both caught):
//   - inside <projectRoot>/artifacts/  (EXCEPT the serialized ledger files,
//     which are writable only through record.cjs — enforced for SHELL writes
//     here; the ledger-write-guard hook covers the file tools for all agents)
//   - the exact repo-root files swarm.yaml, .gitignore
//   - the session marker <projectRoot>/.claude/hooks/.session-active
// NOT writable (F-020): .claude/settings.local.json (self-ungate surface).
// project.yaml was REMOVED from the writable set (ADR-017 Amendment 1 / Stream B
// cutover — D-037 retires the file; phase writes flow through the CLI).

const path = require('node:path');
const fs = require('node:fs');

const PINNED_SCRIPT_RE = /(^|\/)\.claude\/bmad\/bin\/(record|replay-check)\.cjs$/;
const SERIALIZED_FILES = [
  'artifacts/context/ledger.md',
  'artifacts/context/decision-log.md',
  'artifacts/context/task-ledger.md',
];
// Binaries denied outright as a tripwire: interpreters/exec-wrappers (a running
// shell should never reach these — the allow-list already refuses them), plus
// editors. node/nodejs are handled separately (pinned-script exception).
const DENY_BINARIES = new Set([
  'python', 'python2', 'python3', 'perl', 'ruby', 'php',
  'bash', 'sh', 'zsh', 'dash', 'ksh',
  'awk', 'gawk', 'mawk',
  'xargs', 'find',
  'ed', 'ex', 'vi', 'vim', 'nano', 'emacs', 'patch',
]);
// Binaries whose write destination we vet against the writable set.
const WRITE_UTILS = new Set(['tee', 'dd', 'cp', 'mv', 'install', 'rsync', 'ln', 'truncate']);
// git subcommands that rewrite working-tree FILES from an arbitrary source (a
// code-write vector). checkout/switch are NOT here — they are branch-safe and
// only denied in their PATHSPEC form (inspectGit). Deliberately NOT
// commit/add/push/fetch/branch/tag — those record, transmit or name refs, don't
// write source, and are coordination ops (reviewer matrix: `git commit -m "…"`
// must pass the gate). Pinned DISJOINT from the validator's
// GIT_COORDINATION_SUBCMDS by test/orchestrator-allow.test.js.
const GIT_WRITE_SUBCMDS = new Set(['apply', 'restore', 'am', 'stash', 'mv', 'rm']);
// Global git options that consume a FOLLOWING argument. They must be skipped
// before the subcommand is resolved, or `git -C /path apply x` reads `/path` as
// the subcommand and the deny-set never matches (the -C bug).
const GIT_GLOBAL_OPTS_WITH_ARG = new Set(['-C', '--git-dir', '--work-tree', '--namespace']);

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => {
  let event;
  try { event = JSON.parse(input); } catch { process.exit(0); }
  // (1) Teammate subagent calls carry agent_id or agent_type — pass through.
  if (event.agent_id || event.agent_type) { process.exit(0); }
  // (2) Env-var secondary check preserves the local-override recovery path.
  if (process.env.AGENT_ROLE !== 'orchestrator') { process.exit(0); }

  const toolInput = event.tool_input || {};
  const projectRoot = normalizeSlashes(
    process.env.CLAUDE_PROJECT_DIR || event.cwd || process.cwd(),
  );

  // Bash is identified by a `command` string (robust to a missing tool_name).
  if (typeof toolInput.command === 'string') {
    const verdict = inspectBash(toolInput.command, projectRoot, 0);
    if (verdict.deny) { deny(verdict.reason); }
    process.exit(0);
  }

  // File-writing tools: Edit / Write / MultiEdit / NotebookEdit.
  const filePath = toolInput.file_path || toolInput.notebook_path || toolInput.path || '';
  if (isAllowedWrite(filePath, projectRoot)) { process.exit(0); }
  deny(
    'Blocked: orchestrator role cannot write ' + filePath + '. Delegate code/artifact changes to a teammate spawned via the Agent tool (subagent_type). Allowed orchestrator writes: artifacts/**, swarm.yaml, .gitignore.',
  );
});

// --- helpers (function declarations: hoisted) -----------------------------

function normalizeSlashes(p) {
  return String(p == null ? '' : p).replace(/\\/g, '/');
}

function unquote(s) {
  if (!s) return s;
  if ((s.startsWith('"') && s.endsWith('"')) || (s.startsWith("'") && s.endsWith("'"))) {
    return s.slice(1, -1);
  }
  return s;
}

function stripQuotes(s) {
  return String(s == null ? '' : s).replace(/['"]/g, '');
}

function shellReason(what) {
  return 'Blocked: orchestrator role cannot write via shell (' + what + '). Delegate code/artifact changes to a teammate spawned via the Agent tool (subagent_type). The orchestrator may run read-only inspection (git status/log/diff/show, ls, grep, rg, cat, npm test) and the pinned helpers (node .claude/bmad/bin/record.cjs, node .claude/bmad/bin/replay-check.cjs).';
}

// Resolve `rawPath` to an absolute POSIX path WITHOUT touching the filesystem.
// Returns null when a `..` segment is present (F-017 traversal guard).
function resolveTarget(rawPath, projectRoot) {
  const norm = normalizeSlashes(rawPath);
  if (!norm) return null;
  if (norm.split('/').includes('..')) return null;
  return path.posix.isAbsolute(norm)
    ? path.posix.normalize(norm)
    : path.posix.normalize(normalizeSlashes(projectRoot) + '/' + norm);
}

// True iff the resolved path is a protected serialized ledger file (writable
// only through record.cjs — never a raw shell write).
function isSerialized(abs, root) {
  return SERIALIZED_FILES.some((rel) => abs === root + '/' + rel);
}

// F-017 realpath guard: after the lexical check passes, resolve the nearest
// EXISTING ancestor directory and confirm it still sits inside the writable
// tree, so a symlinked ancestor (ln -s /outside artifacts/esc) is caught.
function realAncestorWithin(abs, root) {
  let realRoot;
  try { realRoot = normalizeSlashes(fs.realpathSync(root)); } catch { return true; }
  const realArtifacts = realRoot + '/artifacts';
  let dir = path.posix.dirname(abs);
  const seen = new Set();
  while (dir && dir !== '/' && !seen.has(dir)) {
    seen.add(dir);
    let real;
    try { real = normalizeSlashes(fs.realpathSync(dir)); }
    catch { dir = path.posix.dirname(dir); continue; }
    return real === realRoot
      || real === realArtifacts
      || real.startsWith(realArtifacts + '/');
  }
  return true; // no existing ancestor resolved — lexical check already held
}

// Writable set for the FILE tools (serialized carve-out is enforced separately
// by ledger-write-guard for all agents).
function isAllowedWrite(rawPath, projectRoot) {
  const abs = resolveTarget(rawPath, projectRoot);
  if (!abs) return false;
  const root = path.posix.normalize(normalizeSlashes(projectRoot));
  const artifactsRoot = root + '/artifacts';
  const lexOk =
    abs === artifactsRoot || abs.startsWith(artifactsRoot + '/') ||
    abs === root + '/swarm.yaml' ||
    abs === root + '/.gitignore' ||
    abs === root + '/.claude/hooks/.session-active';
  if (!lexOk) return false;
  return realAncestorWithin(abs, root);
}

// Writable set for SHELL writes (redirect targets, util destinations): the file
// writable set MINUS the serialized ledger files.
function isShellWritable(rawPath, projectRoot) {
  const abs = resolveTarget(rawPath, projectRoot);
  if (!abs) return false;
  const root = path.posix.normalize(normalizeSlashes(projectRoot));
  if (isSerialized(abs, root)) return false;
  return isAllowedWrite(rawPath, projectRoot);
}

function redirectTargetOk(target, projectRoot) {
  const t = stripQuotes(target);
  if (!t) return true;
  const norm = normalizeSlashes(t);
  if (norm === '/dev/null' || norm.startsWith('/dev/')) return true;
  if (norm === '/tmp' || norm.startsWith('/tmp/')) return true;
  return isShellWritable(t, projectRoot);
}

// --- quote-aware shell tokenizer ------------------------------------------

// Extract command-substitution / process-substitution bodies so they are
// inspected too. `$()`/backticks are live inside double quotes but literal
// inside single quotes.
function extractSubstitutions(cmd) {
  const out = [];
  let i = 0; const n = cmd.length; let sq = false, dq = false;
  while (i < n) {
    const c = cmd[i];
    if (sq) { if (c === "'") sq = false; i++; continue; }
    if (c === '\\') { i += 2; continue; }
    if (c === "'" && !dq) { sq = true; i++; continue; }
    if (c === '"') { dq = !dq; i++; continue; }
    if (c === '`') {
      let j = i + 1, body = '';
      while (j < n && cmd[j] !== '`') { if (cmd[j] === '\\') { body += cmd[j + 1] || ''; j += 2; } else { body += cmd[j]; j++; } }
      out.push(body); i = j + 1; continue;
    }
    if ((c === '$' || c === '<' || c === '>') && cmd[i + 1] === '(') {
      let depth = 1, j = i + 2, body = '';
      while (j < n && depth > 0) {
        if (cmd[j] === '(') depth++;
        else if (cmd[j] === ')') { depth--; if (depth === 0) break; }
        body += cmd[j]; j++;
      }
      out.push(body); i = j + 1; continue;
    }
    i++;
  }
  return out;
}

// Tokenize into {type:'word'|'op', value}. Operators (control + redirection)
// are only recognized OUTSIDE quotes, so `>` inside "…" or '…' stays part of a
// word — the F2-H2 quote-awareness fix.
function tokenizeShell(str) {
  const tokens = [];
  let word = '', has = false;
  const flush = () => { if (has) { tokens.push({ type: 'word', value: word }); word = ''; has = false; } };
  let i = 0; const n = str.length;
  while (i < n) {
    const c = str[i];
    if (c === "'") { has = true; word += c; i++; while (i < n && str[i] !== "'") { word += str[i]; i++; } if (i < n) { word += str[i]; i++; } continue; }
    if (c === '"') { has = true; word += c; i++; while (i < n && str[i] !== '"') { if (str[i] === '\\' && i + 1 < n) { word += str[i] + str[i + 1]; i += 2; continue; } word += str[i]; i++; } if (i < n) { word += str[i]; i++; } continue; }
    if (c === '\\') { has = true; word += c; if (i + 1 < n) { word += str[i + 1]; i += 2; } else i++; continue; }
    if (c === ' ' || c === '\t') { flush(); i++; continue; }
    if (c === '\n' || c === ';') { flush(); tokens.push({ type: 'op', value: ';' }); i++; continue; }
    if (str.substr(i, 2) === '&&') { flush(); tokens.push({ type: 'op', value: '&&' }); i += 2; continue; }
    if (str.substr(i, 2) === '||') { flush(); tokens.push({ type: 'op', value: '||' }); i += 2; continue; }
    if (c === '|') { flush(); tokens.push({ type: 'op', value: '|' }); i += (str[i + 1] === '&' ? 2 : 1); continue; }
    if (c === '&') {
      if (str[i + 1] === '>') { flush(); const op = str[i + 2] === '>' ? '&>>' : '&>'; tokens.push({ type: 'op', value: op }); i += op.length; continue; }
      flush(); tokens.push({ type: 'op', value: '&' }); i++; continue;
    }
    // redirection, with optional leading fd digit
    if (c === '>' || c === '<' || (/[0-9]/.test(c) && (str[i + 1] === '>' || str[i + 1] === '<'))) {
      let j = i, fd = '';
      if (/[0-9]/.test(str[j])) { fd = str[j]; j++; }
      const ch = str[j];
      if (ch === '>' || ch === '<') {
        flush();
        let op = ch; j++;
        if (str[j] === ch) { op += ch; j++; }        // >> or <<
        if (str[j] === '&') { op += '&'; j++; }        // fd dup >& <&
        else if (str[j] === '|') { op += '|'; j++; }   // clobber >|
        tokens.push({ type: 'op', value: fd + op });
        i = j; continue;
      }
    }
    has = true; word += c; i++;
  }
  flush();
  return tokens;
}

function splitSubcommands(tokens) {
  const subs = []; let cur = [];
  for (const t of tokens) {
    if (t.type === 'op' && (t.value === ';' || t.value === '&&' || t.value === '||' || t.value === '|' || t.value === '&')) {
      if (cur.length) subs.push(cur);
      cur = [];
    } else cur.push(t);
  }
  if (cur.length) subs.push(cur);
  return subs;
}

function isWriteRedirect(op) {
  if (/^&>>?$/.test(op)) return true;       // &> &>>
  if (/^\d*>>?\|?$/.test(op)) return true;  // > >> 2> 1>> >|
  return false;                             // >& <& < << are not file writes
}

function leadingBinary(words) {
  const wrappers = new Set(['env', 'command', 'builtin', 'exec', 'sudo', 'doas', 'nice', 'nohup', 'time', 'stdbuf']);
  for (const w of words) {
    const u = unquote(w);
    if (/^[A-Za-z_][A-Za-z0-9_]*=/.test(u)) continue; // VAR=val
    const base = u.replace(/.*\//, '');
    if (wrappers.has(base)) continue;
    return base;
  }
  return null;
}

function inspectNode(words, projectRoot) {
  const args = words.slice(1).map(unquote);
  for (const a of args) {
    if (a === '-e' || a === '--eval' || a === '-p' || a === '--print' ||
        a.startsWith('-e') || a.startsWith('--eval=') || a.startsWith('--print=') || a.startsWith('-p')) {
      return { deny: true, reason: shellReason('node inline eval') };
    }
  }
  const script = args.find((a) => a && !a.startsWith('-'));
  if (script && PINNED_SCRIPT_RE.test(normalizeSlashes(script))) return { deny: false };
  return { deny: true, reason: shellReason('node running a non-pinned script') };
}

function inspectSub(tokens, projectRoot) {
  // 1) redirect targets (quote-aware: only op tokens are redirects).
  const words = [];
  for (let k = 0; k < tokens.length; k++) {
    const t = tokens[k];
    if (t.type === 'op') {
      if (/[<>]/.test(t.value)) {
        const next = tokens[k + 1];
        const operand = next && next.type === 'word' ? next.value : '';
        if (next && next.type === 'word') k++; // consume operand
        if (isWriteRedirect(t.value) && !redirectTargetOk(operand, projectRoot)) {
          return { deny: true, reason: shellReason('redirection to ' + stripQuotes(operand)) };
        }
      }
      continue;
    }
    words.push(t.value);
  }
  if (!words.length) return { deny: false };

  const base = leadingBinary(words);
  if (!base) return { deny: false };
  // words after the binary (skip leading wrappers/VAR= up to the binary).
  const binIdx = words.findIndex((w) => unquote(w).replace(/.*\//, '') === base);
  const binWords = words.slice(binIdx);
  const args = binWords.slice(1).map(unquote);

  if (base === 'node' || base === 'nodejs') return inspectNode(binWords, projectRoot);
  if (DENY_BINARIES.has(base)) return { deny: true, reason: shellReason(base + ' (interpreter/editor/exec-wrapper)') };
  if (base === 'sed') {
    if (args.some((a) => a === '-i' || a.startsWith('-i') || a === '--in-place' || a.startsWith('--in-place'))) {
      return { deny: true, reason: shellReason('sed -i (in-place edit)') };
    }
    return { deny: false };
  }
  if (base === 'git') return inspectGit(args);
  if (WRITE_UTILS.has(base)) return inspectWriteUtil(base, args, projectRoot);
  return { deny: false };
}

// Inspect a `git` invocation. `args` is everything after the `git` token
// (already unquoted). Consume option-with-argument globals FIRST (the -C bug),
// deny the -c alias/shell-escape and --exec-path binary-substitution vectors,
// then classify the subcommand: write-vector + destructive shapes are denied;
// coordination shapes (commit/push/fetch/branch/tag, merge --ff-only,
// checkout|switch branch-form, and all read subcommands) pass.
function inspectGit(args) {
  let i = 0;
  while (i < args.length) {
    const a = args[i];
    if (a === '-c') {
      const val = args[i + 1] || '';
      if (/^alias\./i.test(val) || val.includes('!')) {
        return { deny: true, reason: shellReason('git -c ' + stripQuotes(val) + ' (alias/shell-escape)') };
      }
      i += 2; continue;
    }
    if (a.startsWith('-c') && a.length > 2) {
      const val = a.slice(2);
      if (/^alias\./i.test(val) || val.includes('!')) {
        return { deny: true, reason: shellReason('git -c (alias/shell-escape)') };
      }
      i += 1; continue;
    }
    if (a === '--exec-path' || a.startsWith('--exec-path=')) {
      return { deny: true, reason: shellReason('git --exec-path (binary substitution)') };
    }
    if (GIT_GLOBAL_OPTS_WITH_ARG.has(a)) { i += 2; continue; }   // consume flag + its argument
    if (a.startsWith('--git-dir=') || a.startsWith('--work-tree=') || a.startsWith('--namespace=')) { i += 1; continue; }
    if (a.startsWith('-')) { i += 1; continue; }                 // other single-token global (-p, --no-pager, …)
    break;                                                       // first non-flag operand = the subcommand
  }
  const sub = args[i];
  if (!sub) return { deny: false };                              // bare `git` (only globals) — no mutation
  const rest = args.slice(i + 1);
  const nonFlag = rest.filter((a) => a && !a.startsWith('-'));

  // write-vector: rewrite tree files from an arbitrary source.
  if (GIT_WRITE_SUBCMDS.has(sub)) {
    return { deny: true, reason: shellReason('git ' + sub + ' (tree mutation)') };
  }
  // checkout / switch: branch-form passes; PATHSPEC-form is a file restore.
  if (sub === 'checkout' || sub === 'switch') {
    const hasCreate = rest.some((a) => a === '-b' || a === '-B' || a === '-c' || a === '-C' || a === '--orphan');
    if (rest.includes('--') || (!hasCreate && nonFlag.length > 1)) {
      return { deny: true, reason: shellReason('git ' + sub + ' with a pathspec (file restore)') };
    }
    return { deny: false };
  }
  // destructive shapes.
  if (sub === 'reset') {
    const bad = rest.find((a) => a === '--hard' || a === '--merge' || a === '--keep');
    if (bad) return { deny: true, reason: shellReason('git reset ' + bad + ' (working-tree/index rewrite)') };
    return { deny: false };                                      // --soft / --mixed / default: HEAD/index only
  }
  if (sub === 'clean') return { deny: true, reason: shellReason('git clean (untracked-file deletion)') };
  if (sub === 'push') {
    if (rest.some((a) => a === '--force' || a === '-f' || a === '--force-with-lease' ||
        a.startsWith('--force-with-lease=') || a === '--delete' || a === '--mirror')) {
      return { deny: true, reason: shellReason('git push (force/delete/mirror)') };
    }
    return { deny: false };
  }
  if (sub === 'merge') {
    if (!rest.includes('--ff-only')) return { deny: true, reason: shellReason('git merge without --ff-only (may create a merge commit)') };
    return { deny: false };
  }
  if (sub === 'pull') {
    if (!rest.includes('--ff-only')) return { deny: true, reason: shellReason('git pull without --ff-only (embeds a merge)') };
    return { deny: false };
  }
  if (sub === 'rebase' || sub === 'filter-branch' || sub === 'filter-repo' || sub === 'update-ref') {
    return { deny: true, reason: shellReason('git ' + sub + ' (history/ref rewrite)') };
  }
  if (sub === 'reflog' && nonFlag[0] === 'expire') {
    return { deny: true, reason: shellReason('git reflog expire (ref-history rewrite)') };
  }
  if (sub === 'gc' && rest.some((a) => a === '--prune' || a.startsWith('--prune='))) {
    return { deny: true, reason: shellReason('git gc --prune (object pruning)') };
  }
  return { deny: false };                                        // coordination + read subcommands pass
}

function inspectWriteUtil(base, args, projectRoot) {
  const operands = args.filter((a) => a && !a.startsWith('-'));
  if (base === 'dd') {
    const of = args.find((a) => a.startsWith('of='));
    if (of && !isShellWritable(of.slice(3), projectRoot)) return { deny: true, reason: shellReason('dd of=' + stripQuotes(of.slice(3))) };
    return { deny: false };
  }
  if (base === 'tee') {
    for (const f of operands) if (!isShellWritable(f, projectRoot)) return { deny: true, reason: shellReason('tee → ' + stripQuotes(f)) };
    return { deny: false };
  }
  if (base === 'truncate') {
    for (const f of operands.filter((a) => !/^\d+[kKmMgG]?$/.test(a))) {
      if (!isShellWritable(f, projectRoot)) return { deny: true, reason: shellReason('truncate → ' + stripQuotes(f)) };
    }
    return { deny: false };
  }
  if (base === 'ln') {
    // ln [-s] TARGET LINK — deny if the LINK dest, or (for -s) the TARGET the
    // symlink would point at, escapes the writable set.
    const symlink = args.some((a) => a === '-s' || (a.startsWith('-') && a.includes('s')));
    const dest = operands[operands.length - 1];
    if (dest && !isShellWritable(dest, projectRoot)) return { deny: true, reason: shellReason('ln → ' + stripQuotes(dest)) };
    if (symlink && operands.length >= 2) {
      const linkTarget = operands[operands.length - 2];
      if (!isShellWritable(linkTarget, projectRoot)) return { deny: true, reason: shellReason('ln -s pointing outside the writable set: ' + stripQuotes(linkTarget)) };
    }
    return { deny: false };
  }
  // cp / mv / install / rsync — last operand is the destination.
  const dest = operands[operands.length - 1];
  if (dest && !isShellWritable(dest, projectRoot)) return { deny: true, reason: shellReason(base + ' → ' + stripQuotes(dest)) };
  return { deny: false };
}

function inspectBash(command, projectRoot, depth) {
  if (depth > 6) return { deny: false };
  // Recurse into command/process substitutions first (defense in depth over the
  // allow-list, which already refuses the wrapper binaries that host them).
  for (const body of extractSubstitutions(command)) {
    const v = inspectBash(body, projectRoot, depth + 1);
    if (v.deny) return v;
  }
  for (const sub of splitSubcommands(tokenizeShell(command))) {
    const v = inspectSub(sub, projectRoot);
    if (v.deny) return v;
  }
  return { deny: false };
}

function deny(reason) {
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'deny',
      permissionDecisionReason: reason,
    },
  }));
  process.exit(0);
}
