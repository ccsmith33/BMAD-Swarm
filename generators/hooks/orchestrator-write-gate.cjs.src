#!/usr/bin/env node
// BMAD Swarm - PreToolUse gate: the orchestrator role's write boundary.
// Generated by bmad-swarm - do not edit manually
//
// Matches Edit|Write|MultiEdit|Bash|NotebookEdit (ADR-017 / Fork A, F-016).
// For the orchestrator identity it (a) confines the file-writing tools to the
// allowed path set and (b) blocks write-shaped shell — output redirection,
// tee/dd/sed -i/cp/mv/install/truncate/ln into disallowed paths, and inline
// interpreter eval (node -e, python -c, ...). This is the structural half of
// delegate-everything: the orchestrator's settings.json allow-list is narrowed
// to read/inspection commands plus the pinned ledger helper, and this gate is
// the defense-in-depth net so a residual write path still lands on a deny.
//
// Two-layer identity check (per ADR-003, HARN-1 fix) — UNCHANGED:
//   (1) Payload signal: event.agent_id / event.agent_type are populated only
//       inside a subagent (teammate) call. Main-thread orchestrator calls have
//       neither. This is the authoritative discriminator — teammates pass
//       through here and keep their working shell.
//   (2) Env signal: AGENT_ROLE=orchestrator (from settings.json env) is kept as
//       defense-in-depth and as the in-session override path (settings.local.json
//       AGENT_ROLE: '' disables the gate).
// Both checks must say "this is main-thread orchestrator" before the gate fires.
//
// Allowed orchestrator writes (F-017 hardened: normalize + `..` reject +
// segment-anchored prefix check, so `src/artifacts/x`, `notes-artifacts/x`, and
// `artifacts/../.claude/...` no longer slip through):
//   - anything inside <projectRoot>/artifacts/
//   - the exact repo-root files project.yaml, swarm.yaml, .gitignore
//   - the session marker <projectRoot>/.claude/hooks/.session-active
// NOT allowed (F-020): .claude/settings.local.json — it can disable this gate,
// so the ADR-003 recovery path is now human-only.

const path = require('node:path');

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => {
  let event;
  try { event = JSON.parse(input); } catch { process.exit(0); }
  // (1) Teammate subagent calls carry agent_id or agent_type. Main-thread
  // orchestrator calls carry neither. Pass through when either is present.
  if (event.agent_id || event.agent_type) { process.exit(0); }
  // (2) Env-var secondary check preserves the local-override recovery path.
  if (process.env.AGENT_ROLE !== 'orchestrator') { process.exit(0); }

  const toolInput = event.tool_input || {};
  const projectRoot = normalizeSlashes(
    process.env.CLAUDE_PROJECT_DIR || event.cwd || process.cwd(),
  );

  // Bash is identified by a `command` string. Keying on the payload shape (not
  // event.tool_name) keeps the file-tool path working for payloads that omit
  // tool_name, exactly as before this hook grew a Bash branch.
  if (typeof toolInput.command === 'string') {
    const verdict = inspectBash(toolInput.command, projectRoot);
    if (verdict.deny) { deny(verdict.reason); }
    process.exit(0);
  }

  // File-writing tools: Edit / Write / MultiEdit / NotebookEdit.
  const filePath = toolInput.file_path || toolInput.notebook_path || toolInput.path || '';
  if (isAllowedWrite(filePath, projectRoot)) { process.exit(0); }
  deny(
    'Blocked: orchestrator role cannot write ' + filePath + '. Delegate code/artifact changes to a teammate spawned via the Agent tool (subagent_type). Allowed orchestrator writes: artifacts/**, project.yaml, swarm.yaml, .gitignore.',
  );
});

// --- helpers (function declarations: hoisted, usable above) ---------------

function normalizeSlashes(p) {
  return String(p == null ? '' : p).replace(/\\/g, '/');
}

function unquote(s) {
  if (!s) return s;
  if ((s.startsWith('"') && s.endsWith('"')) || (s.startsWith("'") && s.endsWith("'"))) {
    return s.slice(1, -1);
  }
  return s;
}

// Resolve `rawPath` (relative → against projectRoot) to an absolute POSIX path
// WITHOUT touching the filesystem. Returns null when the path carries a `..`
// segment — the F-017 traversal guard: `..` is rejected before resolution so a
// path that *contains* an allowed prefix but escapes it can never be allowed.
function resolveTarget(rawPath, projectRoot) {
  const norm = normalizeSlashes(rawPath);
  if (!norm) return null;
  if (norm.split('/').includes('..')) return null;
  const abs = path.posix.isAbsolute(norm)
    ? path.posix.normalize(norm)
    : path.posix.normalize(normalizeSlashes(projectRoot) + '/' + norm);
  return abs;
}

// True iff `rawPath` is inside the orchestrator's writable set, matched by
// resolved-and-segment-anchored comparison (not substring / $-suffix).
function isAllowedWrite(rawPath, projectRoot) {
  const abs = resolveTarget(rawPath, projectRoot);
  if (!abs) return false;
  const root = path.posix.normalize(normalizeSlashes(projectRoot));
  const artifactsRoot = root + '/artifacts';
  if (abs === artifactsRoot || abs.startsWith(artifactsRoot + '/')) return true;
  if (abs === root + '/project.yaml') return true;
  if (abs === root + '/swarm.yaml') return true;
  if (abs === root + '/.gitignore') return true;
  if (abs === root + '/.claude/hooks/.session-active') return true;
  return false;
}

// Redirect targets to /dev/*, /tmp/** (covers the session scratchpad), or an
// otherwise-allowed write path are fine; everything else is a disallowed write.
function redirectTargetOk(target, projectRoot) {
  if (!target) return true;
  const norm = normalizeSlashes(target);
  if (norm === '/dev/null' || norm.startsWith('/dev/')) return true;
  if (norm === '/tmp' || norm.startsWith('/tmp/')) return true;
  return isAllowedWrite(target, projectRoot);
}

// Split a compound command into candidate sub-commands on shell operators.
// Deliberately coarse: over-splitting only makes each piece easier to clear,
// and we DENY on the first piece that writes to a disallowed path. `&&`/`||`
// are listed before single `|` so `||` is never split as two pipes.
function splitCommands(command) {
  // A single `|` preceded by `>` is the clobber operator (`>|`), not a pipe —
  // the negative lookbehind keeps `>| file` intact so its redirect target is
  // still inspected instead of being severed into a harmless-looking fragment.
  return String(command)
    .split(/&&|\|\||[;\n]|(?<![>])\|/)
    .map((s) => s.trim())
    .filter(Boolean);
}

function tokenize(s) {
  const out = [];
  const re = /"[^"]*"|'[^']*'|[^\s]+/g;
  let m;
  while ((m = re.exec(s)) !== null) out.push(m[0]);
  return out;
}

// First real binary in a sub-command, skipping VAR=val assignments and common
// wrappers (so `sudo node -e` / `env FOO=1 node -e` are still inspected as node).
function leadingBinary(tokens) {
  const wrappers = ['env', 'command', 'builtin', 'exec', 'sudo', 'doas'];
  for (let i = 0; i < tokens.length; i++) {
    const t = tokens[i];
    if (/^[A-Za-z_][A-Za-z0-9_]*=/.test(t)) continue; // VAR=val
    const base = unquote(t).replace(/.*\//, '');
    if (wrappers.includes(base)) continue;
    return base;
  }
  return null;
}

const EVAL_FLAGS = {
  node: ['-e', '--eval', '-p', '--print'],
  nodejs: ['-e', '--eval', '-p', '--print'],
  python: ['-c'], python3: ['-c'], python2: ['-c'],
  perl: ['-e', '-E'], ruby: ['-e'], php: ['-r'],
  bash: ['-c'], sh: ['-c'], zsh: ['-c'], dash: ['-c'],
};

// Interpreters are write-capable via inline eval; deny the eval forms. A bare
// script invocation (e.g. `node .claude/bmad/bin/record.cjs …`) is NOT eval and
// passes here — the settings.json allow-list decides which scripts may run.
function inspectInterpreter(base, tokens, reason) {
  const flags = EVAL_FLAGS[base] || [];
  for (const raw of tokens.slice(1)) {
    const t = unquote(raw);
    for (const f of flags) {
      if (t === f || t.startsWith(f + '=') || (f.length === 2 && t.startsWith(f))) {
        return { deny: true, reason: reason(base + ' ' + f + ' (inline interpreter eval)') };
      }
    }
  }
  return { deny: false };
}

function nonFlagArgs(args) {
  return args.map(unquote).filter((a) => a && !a.startsWith('-'));
}

function inspectSub(sub, projectRoot) {
  const reason = (what) =>
    'Blocked: orchestrator role cannot write via shell (' + what + '). Delegate code/artifact changes to a teammate spawned via the Agent tool (subagent_type). The orchestrator may run read-only inspection (git status/log/diff, ls, grep, npm test) and the pinned ledger helper (node .claude/bmad/bin/record.cjs).';

  // 1) Output redirections that write a file (skips fd dups like 2>&1, >&2).
  // The optional `\|` after the operator matches the clobber form `>|`.
  const redir = /(?:&>>?|\d?>>?)\|?(?!&)\s*("[^"]*"|'[^']*'|[^\s|;&<>()]+)/g;
  let m;
  while ((m = redir.exec(sub)) !== null) {
    const target = unquote(m[1]);
    if (!redirectTargetOk(target, projectRoot)) {
      return { deny: true, reason: reason('redirection to ' + target) };
    }
  }

  // 2) Leading binary write-shapes.
  const tokens = tokenize(sub);
  const base = leadingBinary(tokens);
  if (!base) return { deny: false };
  const args = tokens.slice(tokens.findIndex((t) => unquote(t).replace(/.*\//, '') === base) + 1);

  if (Object.prototype.hasOwnProperty.call(EVAL_FLAGS, base)) {
    return inspectInterpreter(base, [base, ...args], reason);
  }
  if (base === 'sed') {
    // In-place edit is a write we can't reliably attribute to a single operand;
    // deny sed -i outright (the orchestrator delegates edits).
    if (args.some((a) => { const u = unquote(a); return u === '-i' || u.startsWith('-i') || u === '--in-place' || u.startsWith('--in-place'); })) {
      return { deny: true, reason: reason('sed -i (in-place edit)') };
    }
    return { deny: false };
  }
  if (base === 'tee') {
    for (const f of nonFlagArgs(args)) {
      if (!isAllowedWrite(f, projectRoot)) return { deny: true, reason: reason('tee → ' + f) };
    }
    return { deny: false };
  }
  if (base === 'dd') {
    const of = args.map(unquote).find((a) => a.startsWith('of='));
    if (of) {
      const target = of.slice(3);
      if (!isAllowedWrite(target, projectRoot)) return { deny: true, reason: reason('dd of=' + target) };
    }
    return { deny: false };
  }
  if (base === 'cp' || base === 'mv' || base === 'install' || base === 'rsync' || base === 'ln') {
    const operands = nonFlagArgs(args);
    const dest = operands[operands.length - 1];
    if (dest && !isAllowedWrite(dest, projectRoot)) {
      return { deny: true, reason: reason(base + ' → ' + dest) };
    }
    return { deny: false };
  }
  if (base === 'truncate') {
    const operands = nonFlagArgs(args).filter((a) => !/^\d+[kKmMgG]?$/.test(a)); // drop bare sizes
    for (const f of operands) {
      if (!isAllowedWrite(f, projectRoot)) return { deny: true, reason: reason('truncate → ' + f) };
    }
    return { deny: false };
  }
  return { deny: false };
}

function inspectBash(command, projectRoot) {
  for (const sub of splitCommands(command)) {
    const v = inspectSub(sub, projectRoot);
    if (v.deny) return v;
  }
  return { deny: false };
}

function deny(reason) {
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'deny',
      permissionDecisionReason: reason,
    },
  }));
  process.exit(0);
}
