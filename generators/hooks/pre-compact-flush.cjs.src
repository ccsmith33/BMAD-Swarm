#!/usr/bin/env node
// BMAD Swarm - the PROJECT-BRAIN PreCompact FLUSH (phase2 design §4.4;
// continuity divergence §2.2 + §6.1). Generated by bmad-swarm - do not edit manually.
//
// Compaction is the exact event that destroys comprehension. This hook turns it
// into the event that PRESERVES comprehension: before the summarizer runs, it
// injects (a) the current project-brain.md and (b) its schema as CUSTOM
// COMPACTION INSTRUCTIONS, steering the summary to become a delta-patch against
// the brain rather than a lossy paraphrase of the whole transcript
// (schema-driven compaction).
//
// SPIKE GROUND TRUTH (v2.1.221, artifacts/exploration/spikes-2026-08-11.md
// spike 2): a PreCompact hook's stdout is merged into the summarizer's custom
// instructions for manual AND auto compaction, and the summarizer honors it.
//
// ALWAYS EXIT 0. Exit 2 blocks compaction itself — including auto-compaction —
// which can pin a session against the context ceiling. This hook only STEERS via
// stdout; it never blocks. Any error is swallowed and we exit 0 (a missing brain
// must never wedge a session mid-compaction).

const fs = require('node:fs');
const path = require('node:path');

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => {
  try {
    emit();
  } catch {
    // never wedge compaction
  }
  process.exit(0);
});
// If stdin never ends (no payload piped), still emit after a tick.
process.stdin.on('error', () => { try { emit(); } catch {} process.exit(0); });

function emit() {
  let event = {};
  try { event = JSON.parse(input); } catch { /* payload optional */ }

  const projectRoot = process.env.CLAUDE_PROJECT_DIR || event.cwd || process.cwd();
  const brainPath = path.join(projectRoot, 'artifacts', 'context', 'project-brain.md');
  const schemaPath = path.join(projectRoot, '.claude', 'bmad', 'methodology', 'artifact-schemas', 'project-brain.md');

  const brain = readIfExists(brainPath);
  const schema = readIfExists(schemaPath);
  const checkpoint = brain ? extractCheckpoint(brain) : null;

  const out = [];
  out.push('=== BMAD PROJECT-BRAIN FLUSH (before you compact this context) ===');

  if (brain) {
    out.push(
      'This project keeps a durable comprehension artifact at '
      + 'artifacts/context/project-brain.md. BEFORE producing the compaction summary, '
      + 'update that brain (via the orchestrator, single writer) to reflect anything '
      + 'load-bearing learned since checkpoint ' + (checkpoint === null ? '(unknown)' : checkpoint)
      + ' that is not already in it — new dead ends, new load-bearing facts, thread '
      + 'state changes, resolved questions. Obey its schema and its ~2,500-token budget '
      + '(evict touch-or-die if over).',
    );
    out.push('');
    out.push('Then SUMMARIZE THE TRANSCRIPT AS A DELTA against the brain below: OMIT '
      + 'anything the brain already holds (it survives compaction independently); emit '
      + 'only the load-bearing residue that is NOT yet captured, phrased so it can be '
      + 'folded into the brain on the next turn. Do not re-summarize what the brain says.');
    out.push('');
    out.push('----- CURRENT project-brain.md (checkpoint ' + (checkpoint === null ? '?' : checkpoint) + ') -----');
    out.push(brain.trim());
    out.push('----- END project-brain.md -----');
  } else {
    out.push(
      'This project has NO project-brain.md yet. During/after compaction, create '
      + 'artifacts/context/project-brain.md (single-writer: the orchestrator) capturing '
      + 'the identity, current mental model, load-bearing facts (with pointers), active '
      + 'threads, dead ends, and open questions — so the next session rehydrates '
      + 'comprehension, not just identity.',
    );
  }

  if (schema) {
    out.push('');
    out.push('----- project-brain SCHEMA (obey section caps + budget) -----');
    out.push(schema.trim());
    out.push('----- END schema -----');
  } else {
    out.push('');
    out.push('project-brain schema: identity <=5 sentences · mental model <=8 bullets · '
      + 'load-bearing facts <=10 (each with a path or D-ID pointer) · active threads <=6 '
      + '(name — state — next — pointer @cN) · dead ends <=6 (approach — why — D-ID) · '
      + 'open questions <=5 · fixed Pointers block. Hard budget ~2,500 tokens.');
  }

  // PreCompact contract: plain stdout text is injected as custom compaction
  // instructions (spike 2). Not JSON.
  process.stdout.write(out.join('\n') + '\n');
}

function readIfExists(p) {
  try { return fs.readFileSync(p, 'utf8'); } catch { return null; }
}

function extractCheckpoint(brain) {
  const m = /^\s*checkpoint:\s*(\d+)\s*$/m.exec(brain);
  return m ? Number(m[1]) : null;
}
