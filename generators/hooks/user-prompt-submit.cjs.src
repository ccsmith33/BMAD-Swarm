#!/usr/bin/env node
// BMAD Swarm - UserPromptSubmit Hook (minimal reminder + human-wake marker)
// Generated by bmad-swarm - do not edit manually
//
// On a fresh session, emits a short reminder pointing the orchestrator
// at the /identity-orchestrator slash command. After the first user
// turn in a session, emits nothing (the marker suppresses re-fires).
//
// HUMAN-AUTHENTICATED EARLY WAKE (phase5 Stream S, D-034): this event fires ONLY
// on a real human prompt — an agent CANNOT fire UserPromptSubmit — so a prompt
// arriving while a night charter is open is proof the human is awake. When a
// charter pointer is present we drop the `.human-wake` marker; the night floor
// reads it to lift, and `record.cjs night-charter close` reads it to legitimize
// an early close. The marker is un-forgeable by construction (only this hook
// writes it) and un-forgeable by tool (the floor write-denies .claude/** at
// night). This runs BEFORE the session-active early-exit so a wake is recorded
// on every human turn of the night, not just the first.

const fs = require('fs');
const path = require('path');

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => { input += chunk; });
process.stdin.on('end', () => {
  let event;
  try { event = JSON.parse(input); } catch { process.exit(0); }
  const cwd = event.cwd || process.cwd();

  // Human-wake marker: a human prompt while a night charter is open ends the night.
  try {
    if (fs.existsSync(path.join(cwd, 'artifacts', 'delivery', '.night-charter-current'))) {
      const hooksDir = path.join(cwd, '.claude', 'hooks');
      fs.mkdirSync(hooksDir, { recursive: true });
      fs.writeFileSync(path.join(hooksDir, '.human-wake'), new Date().toISOString() + '\n');
    }
  } catch { /* best-effort; the marker is convenience, the floor stays armed until it lands or grace passes */ }

  const markerPath = path.join(cwd, '.claude', 'hooks', '.session-active');
  if (fs.existsSync(markerPath)) { process.exit(0); }
  try { fs.writeFileSync(markerPath, Date.now().toString()); } catch {}
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'UserPromptSubmit',
      additionalContext: 'Type /identity-orchestrator to load your role, or /bug /feature /research /audit /brainstorm /migrate /review /plan for common workflows.',
    },
  }));
  process.exit(0);
});
