#!/usr/bin/env node
// BMAD Swarm - PreToolUse gate: regime-router workflow integrity pinning
// (WF-1 / §10.2). Generated by bmad-swarm - do not edit manually.
//
// Threat: a workflow body under .claude/workflows/*.js is evaluated JS, not just
// a sequence of agent() calls. If the runtime exposes Node builtins, a tampered/
// injected body is in-process code execution that no Bash PreToolUse hook can
// observe. The generator's trailing `// bmad-generated:<hash>` marker is only an
// update-idempotency check — it is NEVER verified before the Workflow runtime
// runs the script, and an attacker who edits the body just recomputes it.
//
// This hook fires on the Workflow tool call — the one point BEFORE the runtime
// loads and executes the script — and verifies the invoked named workflow's
// current bytes against the committed sha256 manifest
// (.claude/workflows/integrity.json). FAIL-CLOSED: a hash mismatch, an unknown/
// unpinned name, a missing workflow file, a missing/corrupt manifest, or an
// inline (unpinnable) script all DENY the call.
//
// Scope: it gates ONLY our shipped workflows — a name that does not resolve to a
// file under .claude/workflows/ is a Claude Code built-in and is left alone, so
// this never over-blocks the platform's own workflows.
//
// Residual (documented, not hidden): a day-time teammate with .claude/** write
// access could co-tamper a workflow AND its manifest entry; the committed
// manifest + a byte-identity CI guard catch that at merge/review, and the
// ultimate runtime control for teammates is the Fork A allowlist (per the §10.2
// security review). This hook is the runtime defense-in-depth layer.

const path = require('node:path');
const fs = require('node:fs');
const crypto = require('node:crypto');

const WORKFLOWS_SUBDIR = path.join('.claude', 'workflows');
const MANIFEST_NAME = 'integrity.json';

function sha256(content) {
  return crypto.createHash('sha256').update(String(content).replace(/\r\n/g, '\n')).digest('hex');
}

function deny(reason) {
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'deny',
      permissionDecisionReason: reason,
    },
  }));
  process.exit(0);
}

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => {
  let event;
  try { event = JSON.parse(input); } catch { process.exit(0); }

  // Only our concern: the Workflow tool. Anything else passes through.
  const toolName = event.tool_name || event.toolName || '';
  if (toolName !== 'Workflow') process.exit(0);

  const toolInput = event.tool_input || event.toolInput || {};
  const projectRoot = process.env.CLAUDE_PROJECT_DIR || event.cwd || process.cwd();
  const workflowsDir = path.resolve(projectRoot, WORKFLOWS_SUBDIR);

  // Resolve the invoked workflow to a concrete file, if it is one of OURS.
  // - name: 'bug-fix' | 'bug-fix.js'  -> .claude/workflows/bug-fix.js
  // - scriptPath: an explicit path     -> only gated when it lands under our dir
  // - script (inline): unpinnable code -> fail-closed DENY
  let filePath = null;
  if (typeof toolInput.name === 'string' && toolInput.name.trim() !== '') {
    const base = path.basename(toolInput.name.trim()).replace(/\.js$/, '') + '.js';
    filePath = path.join(workflowsDir, base);
  } else if (typeof toolInput.scriptPath === 'string' && toolInput.scriptPath.trim() !== '') {
    const abs = path.resolve(projectRoot, toolInput.scriptPath.trim());
    if (abs === workflowsDir || abs.startsWith(workflowsDir + path.sep)) filePath = abs;
    else process.exit(0); // a path outside our dir is not our surface
  } else if (typeof toolInput.script === 'string' && toolInput.script.trim() !== '') {
    deny('Workflow integrity: inline/dynamic workflow scripts are unpinned and cannot be integrity-verified. Ship named workflows in .claude/workflows/*.js (WF-1 / §10.2, spike-3 packaging).');
  } else {
    // No name/path/script we recognize — nothing of ours to verify.
    process.exit(0);
  }

  // If the resolved file is not one of ours (built-in name, no such file), it is
  // outside this hook's mandate. Do NOT deny built-ins.
  if (!fs.existsSync(filePath)) {
    const under = filePath === workflowsDir || filePath.startsWith(workflowsDir + path.sep);
    if (!under) process.exit(0);
    deny(`Workflow integrity: named workflow "${path.basename(filePath)}" is not present under .claude/workflows/ — refusing to run an unknown/unpinned workflow (fail-closed, WF-1).`);
  }

  // Load the committed manifest. Missing/corrupt manifest → fail-closed for our
  // workflows (a built-in would already have returned above).
  const manifestPath = path.join(workflowsDir, MANIFEST_NAME);
  let manifest;
  try {
    manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
  } catch {
    deny('Workflow integrity: the workflow manifest (.claude/workflows/integrity.json) is missing or unreadable — refusing to run a named workflow unverified (fail-closed, WF-1).');
  }

  const key = path.basename(filePath);
  const expected = manifest && Object.prototype.hasOwnProperty.call(manifest, key) ? manifest[key] : null;
  if (!expected) {
    deny(`Workflow integrity: "${key}" is not pinned in the manifest — refusing to run an unknown/unpinned workflow (fail-closed, WF-1).`);
  }

  let actual;
  try {
    actual = sha256(fs.readFileSync(filePath, 'utf8'));
  } catch {
    deny(`Workflow integrity: cannot read "${key}" to verify it — refusing to run (fail-closed, WF-1).`);
  }

  if (actual !== expected) {
    deny(`Workflow integrity: "${key}" has been modified since it was generated (sha256 mismatch vs the committed manifest) — refusing to run a tampered workflow (fail-closed, WF-1). Run \`bmad-swarm update\` to regenerate, or revert the file.`);
  }

  // Verified intact — allow the Workflow tool call to proceed.
  process.exit(0);
});
