#!/usr/bin/env node
// BMAD Swarm - PreToolUse gate: the serialized-write channel for the record
// ledger (ADR-021 §3.2 / D-036 / D-049, phase2 design). Generated by bmad-swarm
// - do not edit manually.
//
// Denies DIRECT Edit|Write|MultiEdit|NotebookEdit to the serialized context
// files — for EVERY agent identity, no exceptions — so the only door to them is
// the pinned CLI `node .claude/bmad/bin/record.cjs`. This is the deterministic
// half of the RES-6 fix (two agents raced the decision-log live this session):
// concurrent direct edits are structurally impossible; the CLI does lock +
// atomic append + monotonic ID allocation.
//
// Protected (D-049(c)):
//   - artifacts/context/ledger.md        (R/L/C/F envelope records)
//   - artifacts/context/task-ledger.md   (task lifecycle events; guarded even
//                                          before it exists, so it is protected
//                                          the moment SE-2 creates it)
//   - artifacts/context/decision-log.md  (D records; append via record.cjs
//                                          --type D. Human prose edits happen
//                                          outside Claude's tools and are
//                                          unaffected by this hook.)
// Exempt: project-brain.md (single-writer by protocol — the orchestrator; body
// is prose the CLI shouldn't own) and team-assembly-log.md (declared-intent
// lint file, its own gate).
//
// This gate matches only the file-writing tools; it deliberately does NOT match
// Bash, so `node .claude/bmad/bin/record.cjs …` runs unimpeded. The Fork A
// orchestrator-write-gate is the separate hook that governs shell.

const path = require('node:path');

const PROTECTED_BASENAMES = ['ledger.md', 'task-ledger.md', 'decision-log.md'];

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => {
  let event;
  try { event = JSON.parse(input); } catch { process.exit(0); }

  const toolInput = event.tool_input || {};
  const projectRoot = normalizeSlashes(
    process.env.CLAUDE_PROJECT_DIR || event.cwd || process.cwd(),
  );

  // Edit / Write / MultiEdit / NotebookEdit all name a single target path.
  const filePath = toolInput.file_path || toolInput.notebook_path || toolInput.path || '';
  if (!filePath) { process.exit(0); }

  if (isProtected(filePath, projectRoot)) {
    deny(
      'Blocked: ' + basename(filePath) + ' is a serialized-write file (ADR-021 / D-036). '
      + 'Direct Edit/Write is denied for ALL agents to prevent concurrent-write corruption (RES-6). '
      + 'Append through the pinned CLI instead: '
      + 'node .claude/bmad/bin/record.cjs append --type <D|R|L|C|F> --stdin  (JSON on stdin), '
      + 'or set-status <ID> <status> for a transition. See '
      + '.claude/bmad/methodology/artifact-schemas/record-envelope.md.',
    );
  }
  process.exit(0);
});

// --- helpers (function declarations: hoisted) ------------------------------

function normalizeSlashes(p) {
  return String(p == null ? '' : p).replace(/\\/g, '/');
}

function basename(p) {
  const norm = normalizeSlashes(p);
  return norm.slice(norm.lastIndexOf('/') + 1);
}

// Resolve `rawPath` (relative -> against projectRoot) to an absolute POSIX path
// WITHOUT touching the filesystem, rejecting any `..` segment before resolution
// (the F-017 traversal discipline). Returns null on a traversal path.
function resolveTarget(rawPath, projectRoot) {
  const norm = normalizeSlashes(rawPath);
  if (!norm) return null;
  if (norm.split('/').includes('..')) return null;
  return path.posix.isAbsolute(norm)
    ? path.posix.normalize(norm)
    : path.posix.normalize(normalizeSlashes(projectRoot) + '/' + norm);
}

// True iff `rawPath` resolves to one of the protected serialized files under
// <projectRoot>/artifacts/context/ (segment-anchored, not substring).
function isProtected(rawPath, projectRoot) {
  const abs = resolveTarget(rawPath, projectRoot);
  if (!abs) return false;
  const root = path.posix.normalize(normalizeSlashes(projectRoot));
  const contextRoot = root + '/artifacts/context';
  for (const name of PROTECTED_BASENAMES) {
    if (abs === contextRoot + '/' + name) return true;
  }
  return false;
}

function deny(reason) {
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'deny',
      permissionDecisionReason: reason,
    },
  }));
  process.exit(0);
}
